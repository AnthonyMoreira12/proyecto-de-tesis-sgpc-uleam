<template><main class="admin-updates"><section class="admin-updates__shell"><header class="admin-updates__hero"><div><span>AdministraciÃ³n</span><h1>ActualizaciÃ³n de datos</h1><p>Habilite periodos controlados para completar informaciÃ³n histÃ³rica sin abrir campos sensibles.</p></div><button @click="openNew">Nueva campaÃ±a</button></header>
<nav class="admin-updates__tabs"><button :class="{active:tab==='campanias'}" @click="tab='campanias'">CampaÃ±as</button><button :class="{active:tab==='comunicaciones'}" @click="tab='comunicaciones'">Comunicaciones globales</button></nav><p v-if="error" class="admin-updates__error">{{error}}</p>
<section v-if="tab==='campanias'" class="admin-updates__list"><article v-for="c in campaigns" :key="c.id" class="admin-updates__card"><header><div><span>{{typeLabel(c.tipo)}}</span><h2>{{c.titulo}}</h2></div><b :data-state="c.estado">{{stateLabel(c.estado)}}</b></header><p>{{c.descripcion||'Sin descripciÃ³n.'}}</p><div class="admin-updates__metrics"><span>Afectados <strong>{{c.progreso?.total||0}}</strong></span><span>Completados <strong>{{c.progreso?.completadas||0}}</strong></span><span>Pendientes <strong>{{(c.progreso?.pendientes||0)+(c.progreso?.en_progreso||0)}}</strong></span></div><footer><button @click="showParticipants(c)">Participantes</button><button v-if="c.estado==='borrador'" @click="diagnose(c)">DiagnÃ³stico</button><button v-if="c.estado==='borrador'" @click="edit(c)">Editar</button><button v-if="c.estado==='borrador'" class="primary" @click="activate(c)">Activar</button><button v-if="c.estado==='borrador'" class="danger" @click="remove(c)">Eliminar</button><button v-if="c.estado==='activa'" @click="remind(c)">Recordatorio</button><button v-if="c.estado==='activa'" @click="recalc(c)">Recalcular</button><button v-if="c.estado==='activa'" class="primary" @click="finish(c)">Finalizar</button><button v-if="c.estado==='activa'" class="danger" @click="cancel(c)">Cancelar</button></footer></article><div v-if="!campaigns.length" class="admin-updates__empty">No hay campaÃ±as registradas.</div></section>
<section v-else class="admin-updates__list"><div class="admin-updates__toolbar"><button @click="openCommunication">Nueva comunicaciÃ³n</button></div><article v-for="c in communications" :key="c.id" class="admin-updates__card"><header><div><span>{{commType(c.tipo)}}</span><h2>{{c.titulo}}</h2></div><b>{{c.activa?'Activa':'Inactiva'}}</b></header><p>{{c.mensaje}}</p><footer><button @click="editCommunication(c)">Editar</button><button class="danger" @click="removeCommunication(c)">Eliminar</button></footer></article></section>
</section>
<Teleport to="body">
<div v-if="showCampaignForm" class="sgpc-modal-overlay admin-updates__overlay" @click.self="closeForm"><form class="sgpc-modal-card admin-updates__modal" @submit.prevent="saveCampaign"><header><h2>{{editingId?'Editar campaÃ±a':'Nueva campaÃ±a'}}</h2><button type="button" @click="closeForm">Ã—</button></header><label>TÃ­tulo<input v-model.trim="form.titulo" required></label><label>DescripciÃ³n<textarea v-model.trim="form.descripcion" rows="3"/></label><div class="grid"><label>Tipo<select v-model="form.tipo" @change="form.campos_habilitados=[]"><option value="perfil">Perfil</option><option value="publicacion">Publicaciones</option><option value="proyecto">Proyectos</option></select></label><label>Alcance<select v-model="form.alcance" @change="scopeId=''"><option value="todos">Todos</option><option value="sede">Sede</option><option value="facultad">Facultad</option><option value="carrera">Carrera</option><option value="usuarios">Usuarios especÃ­ficos</option></select></label></div><label v-if="['sede','facultad','carrera'].includes(form.alcance)">Filtro<select v-model="scopeId" required><option value="">Seleccione</option><option v-for="x in scopeOptions" :key="x.id" :value="String(x.id)">{{x.nombre}}</option></select></label><label v-if="form.alcance==='usuarios'">IDs de usuarios separados por coma<input v-model="userIds" placeholder="12, 18, 25" required></label><div class="grid"><label>Inicio<input v-model="form.fecha_inicio" type="datetime-local"></label><label>Fin<input v-model="form.fecha_fin" type="datetime-local"></label></div><fieldset><legend>Campos habilitados</legend><label v-for="f in fieldsForType" :key="f"><input v-model="form.campos_habilitados" type="checkbox" :value="f"> {{fieldLabel(f)}}</label></fieldset><fieldset><legend>ComunicaciÃ³n</legend><label><input v-model="form.crear_aviso" type="checkbox"> Publicar comunicaciÃ³n</label><label><input v-model="form.notificar_internamente" type="checkbox"> NotificaciÃ³n interna</label><label><input v-model="form.enviar_correo" type="checkbox"> Correo</label></fieldset><footer><button type="button" @click="closeForm">Cancelar</button><button class="primary">Guardar</button></footer></form></div>
<div v-if="detail" class="sgpc-modal-overlay admin-updates__overlay" @click.self="detail=null"><section class="sgpc-modal-card admin-updates__modal wide"><header><h2>{{detail.title}}</h2><button @click="detail=null">Ã—</button></header><pre>{{detail.content}}</pre></section></div>
<div v-if="showCommForm" class="sgpc-modal-overlay admin-updates__overlay" @click.self="showCommForm=false"><form class="sgpc-modal-card admin-updates__modal" @submit.prevent="saveCommunication"><header><h2>ComunicaciÃ³n global</h2><button type="button" @click="showCommForm=false">Ã—</button></header><label>TÃ­tulo<input v-model.trim="commForm.titulo" required></label><label>Tipo<select v-model="commForm.tipo"><option value="informacion">InformaciÃ³n</option><option value="actualizacion">ActualizaciÃ³n</option><option value="importante">Importante</option><option value="mantenimiento">Mantenimiento</option></select></label><label>Mensaje<textarea v-model.trim="commForm.mensaje" rows="5" required/></label><div class="grid"><label>Texto del botÃ³n<input v-model.trim="commForm.etiqueta_accion"></label><label>Ruta<input v-model.trim="commForm.ruta_accion" placeholder="/informacion-pendiente"></label></div><label><input v-model="commForm.activa" type="checkbox"> Activa</label><footer><button type="button" @click="showCommForm=false">Cancelar</button><button class="primary">Guardar</button></footer></form></div>
</Teleport>
<SgpcConfirmDialog
  v-model="confirmDialog.open"
  :eyebrow="confirmDialog.eyebrow"
  :title="confirmDialog.title"
  :message="confirmDialog.message"
  :confirm-label="confirmDialog.confirmLabel"
  :tone="confirmDialog.tone"
  @confirm="acceptConfirmation"
/>
</main></template>
<script setup>
import{computed,onMounted,reactive,ref}from"vue";import SgpcConfirmDialog from"../../inicio/ui/SgpcConfirmDialog.vue";import{useModalLayer}from"../../scripts/composables/useModalLayer";import adminApi from"../../scripts/api/adminApi";import{activarCampania,actualizarCampania,apiErrorMessage,asResults,cancelarCampania,crearCampania,crearComunicacion,diagnosticarCampania,eliminarCampania,eliminarComunicacion,enviarRecordatorioCampania,finalizarCampania,listarCampanias,listarComunicaciones,listarParticipantesCampania,recalcularCampania,actualizarComunicacion}from"../../scripts/api/actualizacionesApi";
const tab=ref("campanias"),campaigns=ref([]),communications=ref([]),error=ref(""),showCampaignForm=ref(false),editingId=ref(null),scopeId=ref(""),userIds=ref(""),detail=ref(null),showCommForm=ref(false),commEditing=ref(null),sedes=ref([]),facultades=ref([]),carreras=ref([]);const confirmDialog=reactive({open:false,eyebrow:"AdministraciÃ³n",title:"Confirmar acciÃ³n",message:"",confirmLabel:"Confirmar",tone:"primary",action:null});const modalOpen=computed(()=>Boolean(showCampaignForm.value||detail.value||showCommForm.value));useModalLayer(modalOpen);const empty=()=>({titulo:"",descripcion:"",tipo:"perfil",alcance:"todos",fecha_inicio:"",fecha_fin:"",solo_incompletos:true,campos_habilitados:[],crear_aviso:true,notificar_internamente:true,enviar_correo:false}),form=reactive(empty()),commForm=reactive({titulo:"",mensaje:"",tipo:"informacion",etiqueta_accion:"",ruta_accion:"",activa:true});const fieldMap={perfil:["identificacion","sede","carrera"],publicacion:["sede","carrera","area","subarea","pais","ciudad","proyecto"],proyecto:["sede","carrera","descripcion","fecha_inicio","fecha_fin_planificada","fecha_fin_prorrogada"]},fieldsForType=computed(()=>fieldMap[form.tipo]||[]),scopeOptions=computed(()=>form.alcance==="sede"?sedes.value:form.alcance==="facultad"?facultades.value:carreras.value),fieldLabel=f=>({identificacion:"CÃ©dula",sede:"Sede",carrera:"Carrera",area:"Ãrea UNESCO",subarea:"SubÃ¡rea UNESCO",pais:"PaÃ­s",ciudad:"Ciudad",proyecto:"Proyecto",descripcion:"DescripciÃ³n",fecha_inicio:"Fecha inicio",fecha_fin_planificada:"Fin planificada",fecha_fin_prorrogada:"Fin prorrogada"}[f]||f),typeLabel=v=>({perfil:"Perfil",publicacion:"Publicaciones",proyecto:"Proyectos"}[v]||v),stateLabel=v=>({borrador:"Borrador",activa:"Activa",finalizada:"Finalizada",cancelada:"Cancelada"}[v]||v),commType=v=>({informacion:"InformaciÃ³n",actualizacion:"ActualizaciÃ³n",importante:"Importante",mantenimiento:"Mantenimiento"}[v]||v),list=p=>asResults(p).length?asResults(p):(Array.isArray(p)?p:[]);const dt=v=>v?String(v).slice(0,16):null;
async function load(){try{campaigns.value=list(await listarCampanias());communications.value=list(await listarComunicaciones());const[s,f,c]=await Promise.all([adminApi.selectsSedes(),adminApi.selectsFacultades(),adminApi.selectsCarreras()]);sedes.value=list(s);facultades.value=list(f);carreras.value=list(c)}catch(e){error.value=apiErrorMessage(e)}}function openNew(){Object.assign(form,empty());editingId.value=null;scopeId.value="";userIds.value="";showCampaignForm.value=true}function edit(c){Object.assign(form,{...c,fecha_inicio:dt(c.fecha_inicio),fecha_fin:dt(c.fecha_fin),campos_habilitados:[...(c.campos_habilitados||[])]});editingId.value=c.id;scopeId.value=String(c.filtros_destinatarios?.sede_id||c.filtros_destinatarios?.facultad_id||c.filtros_destinatarios?.carrera_id||"");userIds.value=(c.filtros_destinatarios?.usuarios||[]).join(", ");showCampaignForm.value=true}function closeForm(){showCampaignForm.value=false}function payload(){const filters={};if(form.alcance==="sede")filters.sede_id=Number(scopeId.value);if(form.alcance==="facultad")filters.facultad_id=Number(scopeId.value);if(form.alcance==="carrera")filters.carrera_id=Number(scopeId.value);if(form.alcance==="usuarios")filters.usuarios=userIds.value.split(",").map(x=>Number(x.trim())).filter(Boolean);return{...form,fecha_inicio:form.fecha_inicio||null,fecha_fin:form.fecha_fin||null,filtros_destinatarios:filters}}async function saveCampaign(){try{editingId.value?await actualizarCampania(editingId.value,payload()):await crearCampania(payload());closeForm();await load()}catch(e){error.value=apiErrorMessage(e)}}async function act(fn,c){try{await fn(c.id);await load()}catch(e){error.value=apiErrorMessage(e)}}const activate=c=>act(activarCampania,c),finish=c=>act(finalizarCampania,c),cancel=c=>act(cancelarCampania,c),remind=c=>act(enviarRecordatorioCampania,c),recalc=c=>act(recalcularCampania,c);function askConfirmation({eyebrow="AdministraciÃ³n",title,message,confirmLabel="Confirmar",tone="primary",action}){Object.assign(confirmDialog,{open:true,eyebrow,title,message,confirmLabel,tone,action})}async function acceptConfirmation(){const action=confirmDialog.action;confirmDialog.action=null;if(!action)return;try{await action()}catch(e){error.value=apiErrorMessage(e)}}function remove(c){askConfirmation({title:"Eliminar campaÃ±a",message:`La campaÃ±a â€œ${c.titulo}â€ serÃ¡ eliminada definitivamente mientras permanezca en borrador.`,confirmLabel:"Eliminar",tone:"danger",action:()=>act(eliminarCampania,c)})}async function diagnose(c){try{detail.value={title:`DiagnÃ³stico Â· ${c.titulo}`,content:JSON.stringify(await diagnosticarCampania(c.id),null,2)}}catch(e){error.value=apiErrorMessage(e)}}async function showParticipants(c){try{detail.value={title:`Participantes Â· ${c.titulo}`,content:JSON.stringify(await listarParticipantesCampania(c.id),null,2)}}catch(e){error.value=apiErrorMessage(e)}}function openCommunication(){commEditing.value=null;Object.assign(commForm,{titulo:"",mensaje:"",tipo:"informacion",etiqueta_accion:"",ruta_accion:"",activa:true});showCommForm.value=true}function editCommunication(c){commEditing.value=c.id;Object.assign(commForm,{titulo:c.titulo,mensaje:c.mensaje,tipo:c.tipo,etiqueta_accion:c.etiqueta_accion||"",ruta_accion:c.ruta_accion||"",activa:c.activa});showCommForm.value=true}async function saveCommunication(){try{commEditing.value?await actualizarComunicacion(commEditing.value,{...commForm}):await crearComunicacion({...commForm});showCommForm.value=false;await load()}catch(e){error.value=apiErrorMessage(e)}}function removeCommunication(c){askConfirmation({title:"Eliminar comunicaciÃ³n",message:`La comunicaciÃ³n â€œ${c.titulo}â€ dejarÃ¡ de estar disponible y serÃ¡ eliminada.`,confirmLabel:"Eliminar",tone:"danger",action:async()=>{await eliminarComunicacion(c.id);await load()}})}onMounted(load);
</script><style src="./admin-actualizaciones.css"></style>
